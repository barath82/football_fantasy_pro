# Copy this file to .env and fill in your values
# cp .env.example .env

# App
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Database (matches docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=fantasy_db
DB_USER=fantasy_user
DB_PASSWORD=fantasy_pass

# FPL API
FPL_BASE_URL=https://fantasy.premierleague.com/api
FPL_CACHE_TTL_SECONDS=300
FPL_SYNC_CRON=0 */6 * * *
FPL_CURRENT_SEASON=2026-27

# Auth
API_URL=http://localhost:3001
JWT_SECRET=

# Google OAuth — from console.cloud.google.com. Leave unset to keep
# "Continue with Google" in coming-soon mode.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# X (Twitter) OAuth — from developer.x.com. Leave unset to keep "Continue
# with X" in coming-soon mode. (Backend routes still work if you set these —
# the "Continue with X" button is just hidden on Signup for now, 2026-08-20.)
X_CLIENT_ID=
X_CLIENT_SECRET=

# Resend — from resend.com/api-keys. Leave unset and password-reset emails
# just get logged to the console instead of sent (dev-friendly fallback).
RESEND_API_KEY=
# Only deliverable once fantasybrahma.com is verified in Resend (SPF/DKIM on
# the "send" subdomain) — falls back to the shared onboarding@resend.dev
# sandbox address for local dev if you'd rather not verify a domain yet.
EMAIL_FROM=FantasyBrahma <noreply@fantasybrahma.com>
